// ---------------------------------------------------------------------------
// Business Platform — Multi-tenant schema
// Built from PRD: "پلتفرم جامع مدیریت کسب‌وکارهای خدماتی و تک‌شغلی"
// Layer 1 (CORE) + Layer 2 (shared business modules) are modelled here.
// Industry-specific modules (Layer 3) are added incrementally per vertical.
// ---------------------------------------------------------------------------

generator client {
  provider     = "prisma-client"
  output       = "../generated/client"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ===========================================================================
// CORE — platform core (CORE-01 .. CORE-08)
// ===========================================================================

/// Module registry — every capability is a toggleable module (PRD §2)
enum ModuleKey {
  CRM
  SCH
  FIN
  ATT
  MSG
  SUB
  CAMP
  INV
  HR
  MKT
  SHOP
  DOC
  RPT
  APP
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
}

/// A tenant = one business using the platform (multi-tenant root aggregate)
model Tenant {
  id              String             @id @default(uuid()) @db.Uuid
  slug            String             @unique
  name            String
  industry        String             @default("SPORTS_COACHING")
  legalName       String?
  nationalId      String? // شناسه ملی / کد اقتصادی
  economicCode    String?
  phone           String?
  email           String?
  logoUrl         String?
  address         String?
  timezone        String             @default("Asia/Tehran")
  currency        String             @default("IRR")
  calendar        CalendarType       @default(JALALI)
  locale          String             @default("fa-IR")
  invoicePrefix   String             @default("INV")
  taxRate         Decimal            @default(9) @db.Decimal(5, 2)
  status          TenantStatus       @default(ACTIVE)
  // Public marketplace opt-in (B2C discovery). A business is only listed when
  // the owner enables this and marks individual items as public.
  marketplaceEnabled Boolean         @default(false)
  tagline         String?
  city            String?
  settings        Json               @default("{}")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?

  branches        Branch[]
  members         Member[]
  roles           Role[]
  modules         TenantModule[]
  subscription    Subscription?
  customers       Customer[]
  services        Service[]
  appointments    Appointment[]
  invoices        Invoice[]
  payments        Payment[]
  attendances     Attendance[]
  messages        Message[]
  campaigns       Campaign[]
  auditLogs       AuditLog[]
  wallets         Wallet[]
  plans           Plan[]
  discounts       DiscountCode[]
  documents       Document[]

  // Phase 2 relations
  membershipPlans      MembershipPlan[]
  studentSubscriptions StudentSubscription[]
  sessionPackages      SessionPackage[]
  installments         Installment[]
  expenses             Expense[]
  cashSessions         CashSession[]
  suppliers            Supplier[]
  products             Product[]
  stockMovements       StockMovement[]
  staffProfiles        StaffProfile[]
  leaveRequests        LeaveRequest[]
  payrollEntries       PayrollEntry[]
  loyaltyAccounts      LoyaltyAccount[]
  giftCards            GiftCard[]
  referrals            Referral[]
  surveys              Survey[]
  reviews              Review[]
  orders               Order[]
  contractTemplates    ContractTemplate[]
  contracts            Contract[]
  messageTemplates     MessageTemplate[]
  messageConsents      MessageConsent[]
  waitlistEntries      WaitlistEntry[]
  recurringSeries      RecurringSeries[]

  // Phase 3 completions
  refunds              Refund[]
  paymentLinks         PaymentLink[]
  discountRedemptions  DiscountRedemption[]
  calendarConnections  CalendarConnection[]
  groupBookings        GroupBooking[]
  makeupCredits        MakeupCredit[]
  staffServices        StaffService[]
  chatMessages         ChatMessage[]
  smsPackages          SmsPackage[]
  smsCampaigns         SmsCampaign[]
  familyGroups         FamilyGroup[]
    consentForms         ConsentForm[]
    attendanceQrSessions AttendanceQrSession[]
    absenceRequests      AbsenceRequest[]
    industryRef          Industry             @relation(fields: [industry], references: [key])

    @@index([industry])
    @@index([marketplaceEnabled, status])
    @@map("tenants")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum CalendarType {
  JALALI
  GREGORIAN
}

/// Branch / location (CORE-02)
model Branch {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @db.Uuid
  name        String
  code        String?
  phone       String?
  address     String?
  city        String?
  latitude    Decimal?   @db.Decimal(10, 7)
  longitude   Decimal?   @db.Decimal(10, 7)
  timezone    String     @default("Asia/Tehran")
  isActive    Boolean    @default(true)
  workHours   Json       @default("{}") // per weekday open/close
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members     Member[]
  customers   Customer[]
  appointments Appointment[]
  attendances Attendance[]
  invoices    Invoice[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

/// Roles (CORE-03)
enum SystemRole {
  OWNER
  MANAGER
  STAFF
  ACCOUNTANT
  RECEPTION
  END_USER
}

model Role {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String?      @db.Uuid // null => platform-level template
  key         String
  name        String
  description String?
  isSystem    Boolean      @default(false)
  permissions String[]     @default([])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant      Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members     Member[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("roles")
}

/// A person with access to a tenant (staff or end-user). NOT global identity —
/// the same human may belong to several tenants with separate roles.
model Member {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @db.Uuid
  branchId      String?     @db.Uuid
  roleId        String?     @db.Uuid
  systemRole    SystemRole  @default(STAFF)
  phone         String?
  email         String?
  fullName      String
  avatarUrl     String?
  passwordHash  String?
  isActive      Boolean     @default(true)
  phoneVerified Boolean     @default(false)
  twoFactorEnabled Boolean  @default(false)
  twoFactorSecret  String?
  notificationPrefs Json    @default("{}") // CORE-08 per-event channel preferences
  lastLoginAt   DateTime?
  meta          Json        @default("{}")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch?     @relation(fields: [branchId], references: [id])
  role          Role?       @relation(fields: [roleId], references: [id])
  customer      Customer?
  sessions      Session[]
  otpCodes      OtpCode[]
  auditLogs     AuditLog[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([phone])
  @@map("members")
}

/// CORE-06 — daily/manual backup records (metadata; payload kept off-DB).
model BackupRecord {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String?  @db.Uuid
  kind       String   @default("manual") // daily | manual | point_in_time
  status     String   @default("COMPLETED") // PENDING | COMPLETED | FAILED
  sizeBytes  Int?
  location   String? // storage key / path
  note       String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("backup_records")
}

/// Refresh-token session for a member (auth)
model Session {
  id           String   @id @default(uuid()) @db.Uuid
  memberId     String   @db.Uuid
  tenantId     String   @db.Uuid
  refreshHash  String   @unique
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())

  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([tenantId])
  @@map("sessions")
}

enum OtpPurpose {
  LOGIN
  PHONE_VERIFY
  PASSWORD_RESET
  TWO_FACTOR
}

/// One-time passwords (CORE-01) — mobile OTP login
model OtpCode {
  id          String     @id @default(uuid()) @db.Uuid
  memberId    String?    @db.Uuid
  phone       String
  codeHash    String
  purpose     OtpPurpose @default(LOGIN)
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  consumedAt  DateTime?
  expiresAt   DateTime
  ip          String?
  createdAt   DateTime   @default(now())

  member      Member?    @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([phone, purpose])
  @@map("otp_codes")
}

/// Module activation per tenant (PRD §2 "فعال‌سازی")
model TenantModule {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  key        ModuleKey
  isEnabled  Boolean   @default(true)
  config     Json      @default("{}")
  enabledAt  DateTime  @default(now())
  disabledAt DateTime?

  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("tenant_modules")
}

/// Subscription plan catalogue (SUB module / platform billing)
model Plan {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String?       @db.Uuid // null => platform plan catalogue
  code         String
  name         String
  description  String?
  price        Decimal       @db.Decimal(14, 0)
  currency     String        @default("IRR")
  billingCycle BillingCycle  @default(MONTHLY)
  modules      ModuleKey[]   @default([])
  limits       Json          @default("{}")
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())

  tenant       Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@unique([tenantId, code])
  @@map("plans")
}

model Subscription {
  id            String             @id @default(uuid()) @db.Uuid
  tenantId      String             @unique @db.Uuid
  planId        String?            @db.Uuid
  status        SubscriptionStatus @default(TRIAL)
  currentPeriodStart DateTime     @default(now())
  currentPeriodEnd   DateTime
  trialEndsAt   DateTime?
  canceledAt    DateTime?
  seats         Int                @default(1)
  meta          Json               @default("{}")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan          Plan?              @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

/// Immutable audit trail (CORE-05)
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String?  @db.Uuid
  memberId   String?  @db.Uuid
  action     String
  entity     String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member     Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([tenantId, entity])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// ===========================================================================
// SHARED BUSINESS MODULES (PRD §4)
// ===========================================================================

// ---------------------------------------------------------------------------
// CRM — مدیریت ارتباط با مشتری (§4.1)
// ---------------------------------------------------------------------------

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

enum LeadStage {
  LEAD
  NEGOTIATION
  WON
  LOST
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

model Customer {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @db.Uuid
  memberId     String?      @unique @db.Uuid // linked end-user account (APP module)
  branchId     String?      @db.Uuid // location this end-user belongs to (آموزشگاه/شعبه)
  type         CustomerType @default(INDIVIDUAL)
  fullName     String
  phone        String?
  email        String?
  nationalId   String?
  birthDate    DateTime?
  gender       Gender?
  address      String?
  city         String?
  source       String? // منبع آشنایی
  tags         String[]     @default([]) // VIP, بدهکار, حساس
  leadStage    LeadStage    @default(LEAD)
  notes        String?
  isActive     Boolean      @default(true)
  isRisky      Boolean      @default(false) // SCH-04 مشتری پرریسک
  noShowCount  Int          @default(0) // SCH-04 تعداد عدم حضور
  meta         Json         @default("{}") // industry-specific custom fields
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member       Member?      @relation(fields: [memberId], references: [id], onDelete: SetNull)
  branch       Branch?      @relation(fields: [branchId], references: [id])
  appointments Appointment[]
  invoices     Invoice[]
  attendances  Attendance[]
  wallet       Wallet?
  messages     Message[]
  files        Document[]
  chatMessages ChatMessage[]
  makeupCredits MakeupCredit[]
  familyMemberships FamilyMember[]
  absenceRequests AbsenceRequest[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([tenantId, leadStage])
  @@index([tenantId, branchId])
  @@map("customers")
}

/// Files / attachments archive (DOC-03)
model Document {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  customerId String?   @db.Uuid
  title      String
  category   String?
  fileKey    String // storage key
  mimeType   String?
  size       Int?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([tenantId, customerId])
  @@map("documents")
}

// ---------------------------------------------------------------------------
// SCH — تقویم و نوبت‌دهی (§4.2)
// ---------------------------------------------------------------------------

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELED
  NO_SHOW
  WAITLIST
}

model Service {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @db.Uuid
  name            String
  description     String?
  category        String?
  imageUrl        String?
  durationMinutes Int           @default(60)
  bufferMinutes   Int           @default(0)
  price           Decimal       @default(0) @db.Decimal(14, 0)
  color           String?
  isActive        Boolean       @default(true)
  /// Publish this service to the public marketplace catalog.
  isPublic        Boolean       @default(false)
  meta            Json          @default("{}")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments    Appointment[]

  @@index([tenantId])
  @@index([isPublic, isActive])
  @@map("services")
}

model Appointment {
  id           String            @id @default(uuid()) @db.Uuid
  tenantId     String            @db.Uuid
  branchId     String?           @db.Uuid
  customerId   String            @db.Uuid
  serviceId    String?           @db.Uuid
  staffId      String?           @db.Uuid
  startsAt     DateTime
  endsAt       DateTime
  status       AppointmentStatus @default(SCHEDULED)
  source       String            @default("staff") // staff | app | link
  notes        String?
  cancelReason String?
  remindedAt   DateTime?
  meta         Json              @default("{}")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch?           @relation(fields: [branchId], references: [id])
  customer     Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service      Service?          @relation(fields: [serviceId], references: [id])

  @@index([tenantId, startsAt])
  @@index([tenantId, staffId, startsAt])
  @@index([customerId])
  @@map("appointments")
}

// ---------------------------------------------------------------------------
// FIN — مالی، فاکتور و پرداخت (§4.3)
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELED
  REFUNDED
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @db.Uuid
  branchId      String?       @db.Uuid
  customerId    String        @db.Uuid
  number        String
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  subtotal      Decimal       @default(0) @db.Decimal(14, 0)
  discountTotal Decimal       @default(0) @db.Decimal(14, 0)
  taxTotal      Decimal       @default(0) @db.Decimal(14, 0)
  total         Decimal       @default(0) @db.Decimal(14, 0)
  paidTotal     Decimal       @default(0) @db.Decimal(14, 0)
  currency      String        @default("IRR")
  notes         String?
  meta          Json          @default("{}")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch?       @relation(fields: [branchId], references: [id])
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items         InvoiceItem[]
  payments      Payment[]
  refunds       Refund[]
  paymentLinks  PaymentLink[]
  discountRedemptions DiscountRedemption[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([customerId])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @db.Uuid
  serviceId   String? @db.Uuid
  description String
  quantity    Decimal @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal @default(0) @db.Decimal(14, 0)
  discount    Decimal @default(0) @db.Decimal(14, 0)
  taxRate     Decimal @default(9) @db.Decimal(5, 2)
  total       Decimal @default(0) @db.Decimal(14, 0)

  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

/// PRD FIN-03 — payment methods
enum PaymentMethod {
  CASH
  POS // کارتخوان
  CARD_TO_CARD // کارت به کارت با رسید
  ONLINE_GATEWAY // درگاه آنلاین
  WALLET
  CHECK
  CUSTOMER_CREDIT
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
  REFUNDED
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @db.Uuid
  invoiceId      String?       @db.Uuid
  orderId        String?       @db.Uuid
  customerId     String?       @db.Uuid
  amount         Decimal       @db.Decimal(14, 0)
  currency       String        @default("IRR")
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  provider       String? // mock | zarinpal | idpay ...
  providerRef    String? // authority / token from gateway
  trackingCode   String? // refId / شماره پیگیری
  gatewayPayload Json          @default("{}")
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice        Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  order          Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  walletTx       WalletTransaction?
  refunds        Refund[]

  @@index([tenantId, status])
  @@index([tenantId, orderId])
  @@index([providerRef])
  @@map("payments")
}

enum WalletTransactionType {
  CREDIT
  DEBIT
  GIFT
  REFUND
}

model Wallet {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId     String              @db.Uuid
  customerId   String              @unique @db.Uuid
  balance      Decimal             @default(0) @db.Decimal(14, 0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@index([tenantId])
  @@map("wallets")
}

model WalletTransaction {
  id           String                @id @default(uuid()) @db.Uuid
  walletId     String                @db.Uuid
  paymentId    String?               @unique @db.Uuid
  type         WalletTransactionType
  amount       Decimal               @db.Decimal(14, 0)
  balanceAfter Decimal               @db.Decimal(14, 0)
  reason       String?
  createdAt    DateTime              @default(now())

  wallet       Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)
  payment      Payment?              @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([walletId])
  @@map("wallet_transactions")
}

/// Discount / promo codes (FIN-08)
model DiscountCode {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  code      String
  percent   Decimal?  @db.Decimal(5, 2)
  amount    Decimal?  @db.Decimal(14, 0)
  maxUses   Int?
  usedCount Int       @default(0)
  startsAt  DateTime?
  expiresAt DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  redemptions DiscountRedemption[]

  @@unique([tenantId, code])
  @@map("discount_codes")
}

// ---------------------------------------------------------------------------
// ATT — حضور و غیاب (§4.4)
// ---------------------------------------------------------------------------

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  CANCELED
}

enum AttendanceMethod {
  MANUAL
  QR
  PERSONAL_CODE
  NFC
  GEO
}

model Attendance {
  id         String           @id @default(uuid()) @db.Uuid
  tenantId   String           @db.Uuid
  branchId   String?          @db.Uuid
  customerId String?          @db.Uuid
  memberId   String?          @db.Uuid // staff or self-check-in member
  sessionId  String?          @db.Uuid // attendance QR session (ATT-01)
  status     AttendanceStatus @default(PRESENT)
  method     AttendanceMethod @default(MANUAL)
  checkInAt  DateTime?
  checkOutAt DateTime?
  note       String?
  date       DateTime         @db.Date
  createdAt  DateTime         @default(now())

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch     Branch?          @relation(fields: [branchId], references: [id])
  customer   Customer?        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  session    AttendanceQrSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([tenantId, date])
  @@index([customerId])
  @@index([sessionId])
  @@map("attendances")
}

/// A teacher/manager opens a short-lived rotating QR session (ATT-01). Students
/// scan it and confirm with an OTP to mark themselves present.
model AttendanceQrSession {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  branchId      String?   @db.Uuid
  serviceId     String?   @db.Uuid
  appointmentId String?   @db.Uuid
  label         String?
  code          String // rotating short code shown/stored alongside the QR
  secret        String // per-session key used to derive the rotating token
  rotateSeconds Int       @default(45)
  radiusMeters  Int       @default(150)
  requireOtp    Boolean   @default(true)
  status        AttendanceQrSessionStatus @default(OPEN)
  openedByMemberId String? @db.Uuid
  expiresAt     DateTime
  closedAt      DateTime?
  createdAt     DateTime  @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attendances  Attendance[]

  @@index([tenantId, status])
  @@index([code])
  @@map("attendance_qr_sessions")
}

enum AttendanceQrSessionStatus {
  OPEN
  CLOSED
  EXPIRED
}

/// ATT-03 — a student's self-service request to excuse/justify an absence
/// ("this session I couldn't attend because ..."). Created from the end-user
/// panel and reviewed (approved/rejected with a comment) by the coach/business.
enum AbsenceRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

model AbsenceRequest {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @db.Uuid
  customerId    String               @db.Uuid
  appointmentId String?              @db.Uuid
  serviceId     String?              @db.Uuid
  /// The date of the session the student cannot attend.
  absenceDate   DateTime             @db.Date
  reason        String // بیماری / مسافرت / بدون اطلاع ...
  note          String? // توضیح تکمیلی شاگرد
  status        AbsenceRequestStatus @default(PENDING)
  reviewNote    String? // توضیح مربی هنگام تأیید/رد
  reviewedByMemberId String?         @db.Uuid
  reviewedAt    DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([customerId])
  @@map("absence_requests")
}

