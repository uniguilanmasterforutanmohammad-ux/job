}

// ---------------------------------------------------------------------------
// FIN-13 — لینک پرداخت (payment links with QR)
// ---------------------------------------------------------------------------

enum PaymentLinkStatus {
  ACTIVE
  PAID
  EXPIRED
  CANCELED
}

model PaymentLink {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @db.Uuid
  invoiceId   String?           @db.Uuid
  customerId  String?           @db.Uuid
  token       String            @unique
  amount      Decimal           @db.Decimal(14, 0)
  title       String?
  status      PaymentLinkStatus @default(ACTIVE)
  expiresAt   DateTime?
  paidAt      DateTime?
  visitedCount Int              @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice     Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@map("payment_links")
}

// ---------------------------------------------------------------------------
// FIN-08 — redemption audit for discount codes
// ---------------------------------------------------------------------------

model DiscountRedemption {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  discountCodeId String   @db.Uuid
  invoiceId      String?  @db.Uuid
  customerId     String?  @db.Uuid
  amount         Decimal  @default(0) @db.Decimal(14, 0)
  createdAt      DateTime @default(now())

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  discountCode   DiscountCode   @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)
  invoice        Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([tenantId, discountCodeId])
  @@map("discount_redemptions")
}

// ---------------------------------------------------------------------------
// SCH-09 — تقویم خارجی (Google / Outlook) — abstraction, provider wired later
// ---------------------------------------------------------------------------

model CalendarConnection {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  memberId     String?   @db.Uuid
  provider     String // google | outlook
  externalId   String?
  accessToken  String?
  refreshToken String?
  syncToken    String?
  lastSyncedAt DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, memberId, provider])
  @@map("calendar_connections")
}

// ---------------------------------------------------------------------------
// SCH-06 — رزرو گروهی (a booking that groups several attendees)
// ---------------------------------------------------------------------------

model GroupBooking {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  title       String
  serviceId   String?  @db.Uuid
  staffId     String?  @db.Uuid
  startsAt    DateTime
  endsAt      DateTime
  capacity    Int      @default(10)
  isOpen      Boolean  @default(true)
  createdAt   DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members     GroupBookingMember[]

  @@index([tenantId, startsAt])
  @@map("group_bookings")
}

model GroupBookingMember {
  id             String   @id @default(uuid()) @db.Uuid
  groupBookingId String   @db.Uuid
  customerId     String   @db.Uuid
  appointmentId  String?  @db.Uuid
  createdAt      DateTime @default(now())

  groupBooking   GroupBooking @relation(fields: [groupBookingId], references: [id], onDelete: Cascade)

  @@unique([groupBookingId, customerId])
  @@map("group_booking_members")
}

// ---------------------------------------------------------------------------
// ATT-04 — جبران جلسه (make-up credits)
// ---------------------------------------------------------------------------

enum MakeupCreditStatus {
  AVAILABLE
  USED
  EXPIRED
  CANCELED
}

model MakeupCredit {
  id             String             @id @default(uuid()) @db.Uuid
  tenantId       String             @db.Uuid
  customerId     String             @db.Uuid
  sourceAttendanceId String?        @db.Uuid
  serviceId      String?            @db.Uuid
  status         MakeupCreditStatus @default(AVAILABLE)
  expiresAt      DateTime?
  usedAt         DateTime?
  usedAppointmentId String?         @db.Uuid
  note           String?
  createdAt      DateTime           @default(now())

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId, status])
  @@map("makeup_credits")
}

// ---------------------------------------------------------------------------
// HR-05 — نگاشت کارمند به خدمت (staff ↔ service assignment)
// ---------------------------------------------------------------------------

model StaffService {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  staffId   String   @db.Uuid
  serviceId String   @db.Uuid
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([staffId, serviceId])
  @@index([tenantId, serviceId])
  @@map("staff_services")
}

// ---------------------------------------------------------------------------
// MSG-05 — گفتگوی فردی (internal chat with a customer + file share)
// ---------------------------------------------------------------------------

enum ChatDirection {
  INBOUND
  OUTBOUND
}

model ChatMessage {
  id         String        @id @default(uuid()) @db.Uuid
  tenantId   String        @db.Uuid
  customerId String        @db.Uuid
  authorId   String?       @db.Uuid // member id (staff) or null for customer
  direction  ChatDirection @default(OUTBOUND)
  body       String?
  fileKey    String?
  readAt     DateTime?
  createdAt  DateTime      @default(now())

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId, createdAt])
  @@map("chat_messages")
}

// ---------------------------------------------------------------------------
// MSG-07 — بسته پیامکی (SMS packages + usage)
// ---------------------------------------------------------------------------

model SmsPackage {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  title      String
  credits    Int // تعداد پیامک
  used       Int      @default(0)
  amount     Decimal  @default(0) @db.Decimal(14, 0)
  purchasedAt DateTime @default(now())
  expiresAt  DateTime?
  createdAt  DateTime @default(now())

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("sms_packages")
}

// ---------------------------------------------------------------------------
// MKT-04 — کمپین پیامکی هدفمند (segment definition + send tracking)
// ---------------------------------------------------------------------------

model SmsCampaign {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  title        String
  body         String
  segment      Json     @default("{}") // tags/city/minSpend/lastVisitBefore
  totalTargets Int      @default(0)
  sentCount    Int      @default(0)
  skippedCount Int      @default(0)
  status       String   @default("DRAFT") // DRAFT | SENDING | SENT
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("sms_campaigns")
}

// ---------------------------------------------------------------------------
// SUB-06 — تخفیف خانوادگی (family groups)
// ---------------------------------------------------------------------------

model FamilyGroup {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  name         String
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  createdAt    DateTime @default(now())

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members      FamilyMember[]

  @@index([tenantId])
  @@map("family_groups")
}

model FamilyMember {
  id            String   @id @default(uuid()) @db.Uuid
  familyGroupId String   @db.Uuid
  customerId    String   @db.Uuid
  relation      String?  // خواهر/برادر/همسر
  createdAt     DateTime @default(now())

  familyGroup   FamilyGroup @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([familyGroupId, customerId])
  @@index([customerId])
  @@map("family_members")
}

// ---------------------------------------------------------------------------
// DOC-05 — رضایت‌نامه (consent forms, written or electronic)
// ---------------------------------------------------------------------------

model ConsentForm {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  customerId   String?   @db.Uuid
  title        String
  body         String
  status       String    @default("PENDING") // PENDING | SIGNED | REVOKED
  signatureKey String?
  signedAt     DateTime?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("consent_forms")
}

// ===========================================================================
// PLATFORM ADMIN — پنل ادمین کل (خارج از مستأجر؛ مدیریت کل کسب‌وکارها)
// ===========================================================================

/// Platform-level operators. NOT a Member — a separate identity namespace so
/// tenant isolation is never bypassed by an ordinary tenant user.
enum PlatformRole {
  SUPER_ADMIN
  ADMIN
  SUPPORT
}

enum PlatformMemberStatus {
  ACTIVE
  SUSPENDED
}

model PlatformMember {
  id                     String                @id @default(uuid()) @db.Uuid
  phone                  String                @unique
  fullName               String
  email                  String?
  role                   PlatformRole          @default(ADMIN)
  status                 PlatformMemberStatus   @default(ACTIVE)
  passwordHash           String?
  twoFactorEnabled       Boolean               @default(false)
  twoFactorSecret        String?
  /// Secret staged during enrolment; promoted to twoFactorSecret on confirmation.
  twoFactorPendingSecret String?
  twoFactorConfirmedAt   DateTime?
  /// Last accepted TOTP time step — rejects replay of a used code.
  twoFactorLastTimeStep  BigInt?
  lastLoginAt            DateTime?
  meta                   Json                  @default("{}")
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  deletedAt              DateTime?

  sessions   PlatformSession[]
  auditLogs  PlatformAuditLog[]

  @@index([role])
  @@map("platform_members")
}

/// Refresh-token sessions for platform operators (hashes only).
model PlatformSession {
  id               String         @id @default(uuid()) @db.Uuid
  platformMemberId String         @db.Uuid
  refreshHash      String         @unique
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime       @default(now())

  member           PlatformMember @relation(fields: [platformMemberId], references: [id], onDelete: Cascade)

  @@index([platformMemberId])
  @@map("platform_sessions")
}

/// Immutable platform-level audit trail (who changed which tenant/module).
model PlatformAuditLog {
  id               String          @id @default(uuid()) @db.Uuid
  platformMemberId String?         @db.Uuid
  action           String
  entity           String
  entityId         String?
  tenantId         String?         @db.Uuid
  before           Json?
  after            Json?
  ip               String?
  userAgent        String?
  createdAt        DateTime        @default(now())

  platformMember   PlatformMember? @relation(fields: [platformMemberId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([platformMemberId, createdAt])
  @@map("platform_audit_logs")
}

/// Industry / domain of activity registry (PRD §17 + custom verticals).
///
/// The 17 PRD verticals are seeded as `isSystem = true`; the platform admin can
/// add any number of custom industries (a new title) and manage, for every
/// industry, whether new businesses may register and which modules a new
/// business of that industry starts with.
model Industry {
  /// Slug: `SPORTS_COACHING` for system rows, `custom-<slug>` for custom ones.
  key                   String  @id
  label                 String
  description           String?
  /// System industries come from the PRD and cannot be deleted.
  isSystem              Boolean @default(false)
  /// When false, `/register` must not offer this industry.
  isRegistrationEnabled Boolean @default(true)
  /// What this industry calls its end-users (شاگرد/بیمار/هنرجو …).
  endUserNoun           String?
  endUserNounPlural     String?
  /// What this industry calls one of its locations (شعبه/آموزشگاه/مهدکودک …).
  branchNoun            String?
  branchNounPlural      String?
  /// Ascending order in the admin console and the signup selector.
  sortOrder             Int     @default(100)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  modules IndustryModuleDefault[]
  tenants Tenant[]

  @@index([sortOrder])
  @@map("industries")
}

/// Editable default module set of an industry ("ماژول‌های پیش‌فرض صنف").
/// This table is the runtime source of truth; `INDUSTRY_DEFAULT_MODULES` in
/// @repo/shared is only its seed/fallback.
model IndustryModuleDefault {
  id        String   @id @default(uuid()) @db.Uuid
  industry  String
  key       ModuleKey
  createdAt DateTime         @default(now())

  industryRef Industry @relation(fields: [industry], references: [key], onDelete: Cascade)

  @@unique([industry, key])
  @@index([industry])
  @@map("industry_default_modules")
}
