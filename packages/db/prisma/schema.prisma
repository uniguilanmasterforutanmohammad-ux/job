/// Tracks how the order owns its inventory so stock is never deducted twice.
enum OrderStockState {
  NONE // سفارش دستی پنل؛ با تأیید سفارش کسر می‌شود
  RESERVED // هنگام ثبت سفارش (بازارگاه/checkout) کسر شده است
  COMMITTED // پرداخت/تأیید انجام شده و رزرو قطعی است
  RELEASED // لغو یا استرداد؛ موجودی برگشته است
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELED
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String      @db.Uuid
  customerId     String?     @db.Uuid
  number         String
  status         OrderStatus @default(PENDING)
  stockState     OrderStockState @default(NONE)
  items          Json        @default("[]")
  subtotal       Decimal     @default(0) @db.Decimal(14, 0)
  shippingCost   Decimal     @default(0) @db.Decimal(14, 0)
  total          Decimal     @default(0) @db.Decimal(14, 0)
  shippingMethod String?
  trackingCode   String?
  address        String?
  note           String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments       Payment[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@map("orders")
}

