# ---------------------------------------------------------------------------
# Business Platform — environment template. Copy to .env and adjust.
# ---------------------------------------------------------------------------
NODE_ENV=development

# --- Database (PostgreSQL) ---
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform_secret
POSTGRES_DB=business_platform
POSTGRES_PORT=5432
DATABASE_URL=postgresql://platform:platform_secret@localhost:5432/business_platform?schema=public

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Auth / JWT ---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Platform admin console (بنل ادمین کل) ---
# Leave blank in dev: it derives from JWT_ACCESS_SECRET (isolated namespace).
JWT_PLATFORM_SECRET=
JWT_PLATFORM_TTL=8h
JWT_PLATFORM_REFRESH_TTL=7d
# Mandatory TOTP 2FA for platform admins. Defaults to true in production, false in dev.
PLATFORM_2FA_REQUIRED=false

# --- OTP ---
OTP_TTL_SECONDS=120
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_DEV_BYPASS_CODE=123456

# --- URLs ---
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Payments ---
# mock | zarinpal | idpay   (بنل/درگاه اصلی بعداً اضافه می‌شود)
PAYMENT_PROVIDER=mock
PAYMENT_MOCK_CALLBACK_BASE=http://localhost:4000/api/v1/payments/callback

# --- SMS provider ---
SMS_PROVIDER=console   # console | kavenegar | mellipayamak
KAVENEGAR_API_KEY=
